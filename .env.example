# ==============================================================
# SMART FITNESS MONITORING AND HEALTHCARE ENVIRONMENT CONFIG
# ==============================================================

# Flask Server Config
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart-fitness-super-secret-key-2026-college-capstone
PORT=5000
HOST=127.0.0.1

# Firebase Configuration
# FIREBASE_MODE: 'cloud' (requires serviceAccountKey.json) or 'emulated' (built-in persistent local Firestore engine)
FIREBASE_MODE=emulated
FIREBASE_SERVICE_ACCOUNT_KEY=firebase/serviceAccountKey.json
FIREBASE_PROJECT_ID=smart-fitness-health-capstone
FIREBASE_STORAGE_BUCKET=smart-fitness-health-capstone.appspot.com

# SMTP Email Configuration (For Health & Emergency Alerts)
# By default, runs in simulation/console logging mode if credentials are not provided.
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-alert-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=Smart Fitness Alerts <alerts@smartfitness.local>

# Twilio SMS Configuration (Optional for Emergency SMS Alerts)
# By default, runs in simulation/console logging mode if credentials are not provided.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Machine Learning Paths
ML_ACTIVITY_MODEL_PATH=machine_learning/models/activity_classifier.joblib
ML_ANOMALY_MODEL_PATH=machine_learning/models/anomaly_detector.joblib
ML_SCALER_PATH=machine_learning/models/scaler.joblib
ML_METRICS_PATH=machine_learning/models/metrics.json

# Thresholds for Intelligent Health Alerts
HR_RESTING_LOW_THRESHOLD=50
HR_RESTING_HIGH_THRESHOLD=100
HR_EXERCISE_MAX_THRESHOLD=185
SLEEP_MIN_HOURS=6.0
INACTIVITY_MAX_MINUTES=120
